# ---- Backend (Sweet Medical) ----

# Conexión a MongoDB (sin el nombre de la base)
MONGODB_URI=mongodb://127.0.0.1:27018
# Nombre de la base de datos
MONGODB_DB_NAME=SweetMedical

# Puerto del servidor HTTP
PORT=3000
# Interfaz donde escucha el server (0.0.0.0 = todas; requerido por Render)
HOST=0.0.0.0

# Cuántos días a futuro genera turnos el proceso batch
BATCH_DAYS_AHEAD=14

# URL pública del backend, usada por Swagger para el "Try it out" en producción.
# En local podés dejarla vacía (usa http://localhost:PORT).
# PUBLIC_URL=https://sweet-medical-api.onrender.com

# Base de datos usada por los tests de integración (npm run test:integration).
# Por defecto: mongodb://127.0.0.1:27018/SweetMedical_inttest
# MONGODB_TEST_URI=mongodb://127.0.0.1:27018/SweetMedical_inttest
